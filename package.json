{
  "name": "poker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm --filter @poker/web build",
    "start": "pnpm --filter @poker/server start",
    "test": "vitest run",
    "typecheck": "tsc -p packages/engine && tsc -p apps/server && tsc -p apps/web"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.8",
    "tsx": "^4.19.2",
    "@types/node": "^22.10.1"
  },
  "packageManager": "pnpm@10.28.0"
}
